# syntax=docker/dockerfile:1
# GPU training image (optional service in compose.yaml, profile: train).

FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    USE_TF=0 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/workspace/.cache/huggingface \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3-pip curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python

COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv

WORKDIR /workspace
COPY pyproject.toml README.md uv.lock ./
COPY src ./src

RUN python -m venv /opt/venv \
 && . /opt/venv/bin/activate \
 && uv pip install --python /opt/venv/bin/python \
      "torch==2.14.0" --index-url https://download.pytorch.org/whl/cu128 \
 && uv pip install --python /opt/venv/bin/python --no-sources .

ENV PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONPATH=/workspace/src \
    LAYA_DEVICE=cuda \
    BGE_M3_PATH=/workspace/models/bge-m3

CMD ["bash", "-lc", "python -m finetune.prepare_dataset --data data/sample/train.jsonl --out data/processed/train_items.pt && python -m finetune.train --items data/processed/train_items.pt --output checkpoints/laya-domain --epochs 1 --micro-batch 4"]
