# --- App / Laya ---
HF_TOKEN=
LAYA_DEVICE=cpu
LAYA_MODEL=english
LAYA_MODEL_PATH=
LAYA_PRELOAD=1
LAYA_HOST=0.0.0.0
LAYA_PORT=8000
LAYA_API_KEY=
LAYA_TORCH_INDEX=cpu
LAYA_GPU_ID=0
HF_HUB_OFFLINE=0
OMP_NUM_THREADS=4
USE_TF=0

# Local BGE-M3 weights for Qdrant embeddings (https://huggingface.co/BAAI/bge-m3)
BGE_M3_PATH=./models/bge-m3
EMBEDDING_DIM=1024

# --- Postgres ---
POSTGRES_USER=hack
POSTGRES_PASSWORD=hack_postgres_change_me
POSTGRES_DB=hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hack:hack_postgres_change_me@localhost:5432/hack

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
