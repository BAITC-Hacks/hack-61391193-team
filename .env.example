# --- App / Laya ---
HF_TOKEN=
LAYA_DEVICE=cpu
LAYA_MODEL=english
LAYA_MODEL_PATH=
LAYA_PRELOAD=1
LAYA_HOST=0.0.0.0
LAYA_PORT=8000
LAYA_API_KEY=
LAYA_TORCH_INDEX=cpu
LAYA_GPU_ID=0
HF_HUB_OFFLINE=0
OMP_NUM_THREADS=4
USE_TF=0

# Local BGE-M3 weights for Qdrant embeddings (https://huggingface.co/BAAI/bge-m3)
BGE_M3_PATH=./models/bge-m3
EMBEDDING_DIM=1024

# --- Postgres ---
# Shared by the PostgreSQL container and the Java backend.
POSTGRES_USER=hack
POSTGRES_PASSWORD=hack_postgres_change_me
POSTGRES_DB=hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hack:hack_postgres_change_me@localhost:5432/hack

# --- Java backend ---
# Docker publishes the Java backend on 8081; local IDE runs can keep port 8080.
BACKEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Development-only Base64 signing key. Replace with your own random 32+ byte key before publishing.
JWT_SECRET=YWtpbS1sb2NhbC1kZXZlbG9wbWVudC1rZXktY2hhbmdlLW1lLTMyaHl0ZXM=
JWT_TTL_SECONDS=3600
# Created only if this admin account does not exist; restarting does not reset its password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin
ADMIN_USERNAME=admin
# Optional chat-completions endpoint. Empty URL/model keeps the template explanation.
# Use a full endpoint URL ending in /v1/chat/completions; keys stay on the backend.
SIMULATION_LLM_URL=
SIMULATION_LLM_MODEL=
SIMULATION_LLM_API_KEY=
SIMULATION_LLM_TIMEOUT_MS=10000

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hack
MINIO_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET=hack
S3_REGION=us-east-1
